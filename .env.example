# ── Required ───────────────────────────────────────────────────────────
# Groq API key — get from console.groq.com (free, no credit card)
GROQ_API_KEY=
# Tavily API key — get from tavily.com (free tier: 1000 searches/month)
TAVILY_API_KEY=

# ── Infrastructure ─────────────────────────────────────────────────────
# Supabase Postgres connection string (or local Docker connection)
# Leave empty to use MemorySaver locally without a database
# Example for local docker-compose: postgresql://postgres:postgres@localhost:5432/lumen_db
POSTGRES_URL=
FRONTEND_URL=http://localhost:5173

# ── Observability (optional) ───────────────────────────────────────────
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=lumen-research-agent
